### 1.6 Normalization

{%- set norm_params = normalization.get('pipeline_params', {}) -%}
{%- set norm_strat = norm_params.get('strategies', {}) -%}
{%- set norm_method = norm_strat.get('normalization_method', 'ROBUST_LOG_ONLY') | upper -%}
{%- set norm_selection = norm_params.get('selection', {}) -%}
{%- set requested_norm_method = norm_selection.get('requested_method', norm_method) | upper -%}
{%- set is_log = norm_strat.get('log_transform_active', False) %}
